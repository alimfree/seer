# Cloudflare Turnstile (captcha)
# Get these from: https://dash.cloudflare.com → Turnstile → Add Site
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...   # Public - used in frontend

# --- Server-side secrets (set via `wrangler secret put`) ---
# BREVO_API_KEY        → wrangler secret put BREVO_API_KEY
# TURNSTILE_SECRET_KEY → wrangler secret put TURNSTILE_SECRET_KEY
# NEWSLETTER_SECRET    → wrangler secret put NEWSLETTER_SECRET (protects the send endpoint)

# Brevo list IDs are configured in wrangler.toml under [vars]

# Google Analytics
# Replace G-XXXXXXXXXX in BaseLayout.astro with your actual GA4 Measurement ID
