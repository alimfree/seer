---
const benefits = [
  {
    icon: 'task_alt',
    title: 'Zero missed revenue',
    description: 'Catch 100% of high-margin private-pay calls after 5 PM and on weekends, when your office is closed and callers hang up rather than leave a voicemail.',
  },
  {
    icon: 'graphic_eq',
    title: 'Natural, interruption-safe voice',
    description: 'Sub-100ms turn-taking handles noisy clinic environments, background chatter, and soft-spoken callers without awkward delays or cut-offs.',
  },
  {
    icon: 'support_agent',
    title: 'Warm dispatcher handoffs',
    description: 'When a complex edge case arises, Seer executes a live warm transfer to your human dispatcher with a voice summary and screen-pop context card.',
  },
  {
    icon: 'sync_alt',
    title: 'Direct CAD synchronization',
    description: 'Every booked ride is written straight into your dispatch system in real time. No re-keying, no double entry, no dropped trips.',
  },
]
---

<section class="py-24 sm:py-32 px-6 sm:px-8 fade-in-section">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-12 sm:mb-16">
      <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background">
        A dispatch engine that never clocks out.
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
      {benefits.map((benefit) => (
        <div class="flex gap-6">
          <div class="mt-1 shrink-0">
            <span class="material-symbols-outlined text-tertiary text-3xl" aria-hidden="true">{benefit.icon}</span>
          </div>
          <div>
            <h3 class="font-headline text-xl sm:text-2xl text-on-background">{benefit.title}</h3>
            <p class="text-on-surface-variant mt-3 leading-relaxed">{benefit.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
