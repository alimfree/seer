---
const benefits = [
  {
    icon: 'task_alt',
    title: 'Clean claim submission',
    description: 'Automated pre-scrubbing ensures every trip meets specific broker and payer criteria before submission, drastically reducing initial rejections.',
  },
  {
    icon: 'gavel',
    title: 'Active denial management',
    description: 'When denials happen, our system instantly flags them with actionable resolution steps, minimizing rework and days in AR.',
  },
  {
    icon: 'monitoring',
    title: 'Full revenue cycle oversight',
    description: 'Track every trip from dispatch to deposit. Gain full visibility into unbilled trips and aging accounts receivable.',
  },
  {
    icon: 'bar_chart',
    title: 'Transparent reporting',
    description: 'Executive dashboards providing real-time metrics on collection rates, broker performance, and cash flow projections.',
  },
]
---

<section class="py-24 sm:py-32 px-6 sm:px-8 fade-in-section">
  <div class="max-w-7xl mx-auto">
    <div class="max-w-2xl mb-12 sm:mb-16">
      <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background">
        A financial engine for NEMT growth.
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
      {benefits.map((benefit) => (
        <div class="flex gap-6">
          <div class="mt-1 shrink-0">
            <span class="material-symbols-outlined text-tertiary text-3xl" aria-hidden="true">{benefit.icon}</span>
          </div>
          <div>
            <h3 class="font-headline text-xl sm:text-2xl text-on-background">{benefit.title}</h3>
            <p class="text-on-surface-variant mt-3 leading-relaxed">{benefit.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
