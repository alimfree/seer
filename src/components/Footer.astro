---
const year = new Date().getFullYear()
---

<footer class="w-full py-16 bg-surface-container-highest" role="contentinfo">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8">
      <div>
        <a href="/" class="block mb-4"><img src="/logo.svg" alt="Zayd Health" class="h-7 w-auto" /></a>
        <div class="text-sm tracking-wide text-on-surface-variant leading-relaxed">
          &copy; {year} Zayd Health. All rights reserved.
        </div>
      </div>
      <div>
        <h4 class="text-sm font-body font-semibold uppercase tracking-widest text-on-background mb-4">Resources</h4>
        <div class="flex flex-col gap-2">
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/resources/clinical">
            Clinical Guides
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/resources/billing">
            Billing Guides
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/resources/compliance">
            Compliance
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/resources/operations">
            Operations
          </a>
        </div>
      </div>
      <div>
        <h4 class="text-sm font-body font-semibold uppercase tracking-widest text-on-background mb-4">Product</h4>
        <div class="flex flex-col gap-2">
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/#how-it-works">
            How It Works
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/#revenue-calculator">
            Calculator
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/#faq">
            FAQ
          </a>
        </div>
      </div>
      <div>
        <h4 class="text-sm font-body font-semibold uppercase tracking-widest text-on-background mb-4">Company</h4>
        <div class="flex flex-col gap-2">
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/privacy">
            Privacy Policy
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/terms">
            Terms of Service
          </a>
          <a class="text-on-surface-variant text-sm tracking-wide hover:text-tertiary transition-colors duration-300" href="/#contact">
            Contact
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
