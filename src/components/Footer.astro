---
const year = new Date().getFullYear()
---

<footer class="w-full py-16 bg-secondary" role="contentinfo">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-12 md:gap-16">
      <div>
        <a href="/" class="block mb-4"><img src="/logo.svg" alt="Seer Mobility" width="120" height="28" class="h-7 w-auto invert" /></a>
        <div class="text-sm tracking-wide text-on-secondary/70 leading-relaxed">
          &copy; {year} Seer Mobility. All rights reserved.
        </div>
      </div>
      <div>
        <p class="text-sm font-body font-medium text-on-secondary mb-4">Company</p>
        <div class="flex flex-col gap-2">
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/">Product</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/pricing/">Pricing</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/privacy/">Privacy Policy</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/terms/">Terms of Service</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/#contact">Contact</a>
        </div>
      </div>
      <div>
        <p class="text-sm font-body font-medium text-on-secondary mb-4">Resources</p>
        <div class="flex flex-col gap-2">
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/resources/billing/">Billing Guides</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/resources/compliance/">Compliance</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/resources/operations/">Operations</a>
          <a class="text-on-secondary/70 text-sm tracking-wide hover:text-on-secondary transition-colors duration-300" href="/tools/nemt-revenue-calculator/">Revenue Calculator</a>
        </div>
      </div>
    </div>
  </div>
</footer>
