---
const steps = [
  {
    title: 'Assessment',
    description: 'We audit your current AR and trip logs to identify immediate revenue opportunities and denial patterns.',
  },
  {
    title: 'Onboarding',
    description: 'Seamless integration with your dispatch software, credentialing, and existing broker relationships.',
  },
  {
    title: 'Ongoing submission',
    description: 'Daily clean claim generation and proactive portal management across every broker you work with.',
  },
  {
    title: 'Monthly optimization',
    description: 'Strategic reviews to tighten documentation, improve internal processes, and maximize yield.',
  },
]
---

<section class="py-24 sm:py-32 bg-surface-container-low fade-in-section" id="how-it-works">
  <div class="max-w-7xl mx-auto px-6 sm:px-8">
    <div class="text-center mb-16 sm:mb-20">
      <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background">
        How we transform your billing.
      </h2>
    </div>
    <div class="flex flex-col md:flex-row justify-between relative gap-12 md:gap-4">
      <div class="hidden md:block absolute top-6 left-[10%] right-[10%] h-px bg-outline-variant/30 z-0" aria-hidden="true"></div>
      {steps.map((step, i) => (
        <div class="flex flex-col items-center text-center relative z-10 w-full md:w-1/4">
          <div class="w-12 h-12 rounded-full btn-primary text-on-primary flex items-center justify-center font-medium text-lg mb-6">
            {i + 1}
          </div>
          <h3 class="font-headline text-xl text-on-background mb-3">{step.title}</h3>
          <p class="text-on-surface-variant leading-relaxed px-4">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
