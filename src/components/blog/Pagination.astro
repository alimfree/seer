---
interface Props {
  currentPage: number
  totalPages: number
  basePath: string  // e.g. "/resources/page" or "/resources/clinical/page"
}

const { currentPage, totalPages, basePath } = Astro.props

if (totalPages <= 1) return

const pages = Array.from({ length: totalPages }, (_, i) => i + 1)

// Page 1 strips "/page" suffix to go to the root listing
const rootPath = basePath.replace(/\/page$/, '')

function pageUrl(page: number): string {
  return page === 1 ? rootPath : `${basePath}/${page}`
}
---

<nav class="flex items-center justify-center gap-2 mt-12" aria-label="Pagination">
  {currentPage > 1 && (
    <a
      href={pageUrl(currentPage - 1)}
      class="text-sm text-on-surface-variant hover:text-tertiary transition-colors px-3 py-2"
    >
      Previous
    </a>
  )}

  {pages.map((page) => (
    <a
      href={pageUrl(page)}
      class={`text-sm px-3 py-2 rounded-sm transition-colors ${
        page === currentPage
          ? 'bg-primary text-on-primary'
          : 'text-on-surface-variant hover:text-tertiary hover:bg-surface-container'
      }`}
    >
      {page}
    </a>
  ))}

  {currentPage < totalPages && (
    <a
      href={pageUrl(currentPage + 1)}
      class="text-sm text-on-surface-variant hover:text-tertiary transition-colors px-3 py-2"
    >
      Next
    </a>
  )}
</nav>
