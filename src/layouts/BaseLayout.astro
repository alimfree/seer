---
import '../styles/global.css'
import Navbar from '../components/react/Navbar'
import FloatingCTA from '../components/react/FloatingCTA'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  canonical?: string
  ogType?: string
  ogImage?: string
  ogTitle?: string
  ogDescription?: string
  jsonLd?: object | object[]
  noFooter?: boolean
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  ogImage = 'https://www.seermobility.com/og-image.png',
  ogTitle = title,
  ogDescription = description,
  jsonLd,
  noFooter = false,
} = Astro.props

const site = 'https://www.seermobility.com'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Seer Mobility" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Seer Mobility" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Seer Mobility — AI Voice Dispatch for NEMT Fleets" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Seer Mobility — AI Voice Dispatch for NEMT Fleets" />

    <!-- DNS prefetch for external domains -->
    <link rel="dns-prefetch" href="https://calendly.com" />
    <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- RSS feed discovery -->
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Seer Mobility Resources" />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000b13" />

    <!-- Google Analytics (GA4) — deferred until after page load -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4W2Q229GH3');
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-4W2Q229GH3';
        s.async = true;
        document.head.appendChild(s);
      });
    </script>

    <!-- Fonts: preload only the body font (Inter) — others load via @font-face as needed -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      Array.isArray(jsonLd)
        ? jsonLd.map((ld) => (
            <script type="application/ld+json" set:html={JSON.stringify(ld)} />
          ))
        : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />
  </head>
  <body>
    <Navbar client:load currentPath={Astro.url.pathname} />
    <FloatingCTA client:idle />
    <slot />
    {!noFooter && <Footer />}

    <!-- Fade-in observer for static .astro sections -->
    <script is:inline>
      (function() {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.fade-in-section').forEach(function(el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
