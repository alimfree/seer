---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Documentation from '../components/Documentation.astro'
import BuiltFor from '../components/BuiltFor.astro'
import Positioning from '../components/Positioning.astro'
import RequestCall from '../components/react/RequestCall'
import FAQ from '../components/react/FAQ'
import ContactForm from '../components/react/ContactForm'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Seer Mobility',
  description: '24/7 AI voice dispatch for NEMT fleets. Seer answers every call instantly, books rides, and writes directly into your CAD dispatch system.',
  areaServed: 'US',
  provider: {
    '@type': 'Organization',
    name: 'Seer Mobility',
    url: 'https://www.seermobility.com',
  },
}

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How is this different from a regular answering service or IVR?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "A generic answering service takes a message. Seer holds a real conversation: it verifies pickup and drop-off addresses, confirms mobility needs, quotes rates, and books the ride directly into your dispatch system, no callback required.",
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to change my dispatch software?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Seer integrates with MediRoutes, RouteGenie, TripSpark, RoutingBox, and VectorCare, or connects to any system via a custom webhook.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens when a call needs a human?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For complex edge cases, Seer executes a live warm transfer to your dispatcher with a voice summary and screen-pop context card.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can it handle after-hours only, or my full call line?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Both. Start with after-hours and overflow coverage, or route your full call line to Seer for 24/7 dispatch.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a long-term contract?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Month-to-month, cancel anytime. Every plan starts with a 14-day free pilot.',
      },
    },
    {
      '@type': 'Question',
      name: 'How secure is my caller and rider data?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HIPAA-compliant handling of rider PHI with encrypted data storage and strict access controls.',
      },
    },
  ],
}
---

<BaseLayout
  title="AI Voice Dispatch for NEMT Fleets | Seer Mobility"
  description="24/7 AI voice dispatching for NEMT fleets. Seer answers every call instantly, books rides, and writes directly into your CAD dispatch system."
  canonical="https://www.seermobility.com/"
  ogTitle="AI Voice Dispatch for NEMT Fleets | Seer Mobility"
  ogDescription="24/7 AI voice dispatching for NEMT fleets. Seer answers every call instantly, books rides, and writes directly into your CAD dispatch system."
  jsonLd={[structuredData, faqStructuredData]}
>
  <main id="main-content">
    <Hero />
    <Documentation />

    <!-- Live Call Request Section -->
    <section class="py-24 sm:py-32 bg-surface fade-in-section" id="live-demo">
      <div class="max-w-7xl mx-auto px-6 sm:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="max-w-2xl">
            <span class="font-body text-sm uppercase tracking-widest text-secondary/60 font-semibold mb-4 block">
              Live Demo
            </span>
            <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light leading-tight text-on-background mb-6">
              Hear the AI dispatcher for yourself.
            </h2>
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-8">
              Leave your number and we'll set up a live call so you can hear exactly how Seer sounds on a real dispatch conversation, interruptions, address verification, and all.
            </p>
            <div class="flex items-center gap-4 py-4 border-t border-outline-variant/30">
              <span class="material-symbols-outlined text-tertiary" aria-hidden="true">phone_in_talk</span>
              <span class="text-on-surface-variant">No pressure, no pitch deck. Just the agent, live.</span>
            </div>
          </div>
          <RequestCall client:visible />
        </div>
      </div>
    </section>

    <BuiltFor />
    <HowItWorks />
    <Positioning />

    <!-- FAQ Section -->
    <section class="py-24 sm:py-32 bg-surface-container-low px-6 sm:px-8 fade-in-section" id="faq">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background mb-12 sm:mb-16 text-center">
          Questions
        </h2>
        <FAQ client:visible />
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-24 sm:py-32 px-6 sm:px-8 bg-surface-container-highest fade-in-section" id="contact">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background mb-6 leading-tight">
              See what 24/7 dispatch looks like for your fleet.
            </h2>
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-8">
              Drop us a message and we'll walk through your call volume, show you where you're losing rides, and set up your 14-day free pilot.
            </p>
          </div>
          <div class="bg-surface-container-lowest p-8 sm:p-10 rounded-sm shadow-ambient ghost-border">
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
