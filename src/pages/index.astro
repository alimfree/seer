---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Documentation from '../components/Documentation.astro'
import BuiltFor from '../components/BuiltFor.astro'
import Positioning from '../components/Positioning.astro'
import Calculator from '../components/react/Calculator'
import FAQ from '../components/react/FAQ'
import ContactForm from '../components/react/ContactForm'

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Seer Mobility',
  description: 'Full-service billing and revenue cycle management for NEMT operators. Clean claim submission, active denial management, and revenue cycle oversight across major brokers and payers.',
  areaServed: 'US',
  provider: {
    '@type': 'Organization',
    name: 'Seer Mobility',
    url: 'https://www.seermobility.com',
  },
}

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How is this different from hiring an in-house biller?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "We combine dedicated billing specialists with software that pre-scrubs every claim against broker and state Medicaid rules before it's ever submitted. You get the accountability of a team plus the consistency of automation, without the overhead of building a full in-house department.",
      },
    },
    {
      '@type': 'Question',
      name: 'Which brokers and payers do you work with?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We bill directly through ModivCare, MTM, and most state Medicaid NEMT programs, along with commercial and managed care payers.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to change my dispatch software?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. We integrate with the dispatch and trip-logging tools you already use to pull the data we need for clean claim submission.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens when a claim is denied?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every denial is triaged with a documented resolution path — resubmission, appeal, or write-off with an explanation.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a long-term contract?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Month-to-month, cancel anytime.',
      },
    },
    {
      '@type': 'Question',
      name: 'How secure is my trip and rider data?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'HIPAA-compliant handling of rider PHI with encrypted data storage and strict access controls.',
      },
    },
  ],
}
---

<BaseLayout
  title="NEMT Billing & Revenue Cycle Management | Seer Mobility"
  description="Full-service billing and revenue cycle management built for NEMT operators. Higher clean claim rates, lower denials, and better cash flow."
  canonical="https://www.seermobility.com/"
  ogTitle="NEMT Billing & Revenue Cycle Management | Seer Mobility"
  ogDescription="Full-service billing and revenue cycle management built for NEMT operators. Higher clean claim rates, lower denials, and better cash flow."
  jsonLd={[structuredData, faqStructuredData]}
>
  <main id="main-content">
    <Hero />
    <Documentation />

    <!-- Calculator Section -->
    <section class="py-24 sm:py-32 bg-surface fade-in-section" id="revenue-calculator">
      <div class="max-w-7xl mx-auto px-6 sm:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="max-w-2xl">
            <span class="font-body text-sm uppercase tracking-widest text-secondary/60 font-semibold mb-4 block">
              Analysis
            </span>
            <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light leading-tight text-on-background mb-6">
              Discover how much denials are really costing you.
            </h2>
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-8">
              Most operators don't know their real denial rate until it's costing them tens of thousands a year. See what clean claims could recover for your fleet.
            </p>
            <div class="flex items-center gap-4 py-4 border-t border-outline-variant/30">
              <span class="material-symbols-outlined text-tertiary" aria-hidden="true">analytics</span>
              <span class="text-on-surface-variant">Calculated from your trip volume and current denial rate.</span>
            </div>
          </div>
          <Calculator client:visible />
        </div>
      </div>
    </section>

    <BuiltFor />
    <HowItWorks />
    <Positioning />

    <!-- FAQ Section -->
    <section class="py-24 sm:py-32 bg-surface-container-low px-6 sm:px-8 fade-in-section" id="faq">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background mb-12 sm:mb-16 text-center">
          Questions
        </h2>
        <FAQ client:visible />
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-24 sm:py-32 px-6 sm:px-8 bg-surface-container-highest fade-in-section" id="contact">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-background mb-6 leading-tight">
              See what clean billing looks like for your fleet.
            </h2>
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-8">
              Drop us a message and we'll walk through your numbers, show you where you're losing revenue, and what a free billing assessment covers.
            </p>
            <a
              href="mailto:hello@seermobility.com"
              class="inline-flex items-center gap-3 px-8 py-4 bg-tertiary text-on-tertiary font-medium rounded-sm shadow-ambient hover:brightness-110 transition-all duration-300"
            >
              <span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
              Email Us Directly
            </a>
          </div>
          <div class="bg-surface-container-lowest p-8 sm:p-10 rounded-sm shadow-ambient ghost-border">
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
