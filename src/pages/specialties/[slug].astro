---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import EmailCapture from '../../components/react/EmailCapture'
import { SPECIALTIES } from '../../lib/specialties'
import { resolveCategory, getPostUrl } from '../../lib/blog'

export const getStaticPaths: GetStaticPaths = async () => {
  return SPECIALTIES.map((s) => ({
    params: { slug: s.slug },
    props: { specialty: s },
  }))
}

const { specialty } = Astro.props

const allPosts = (await getCollection('blog'))
  .filter((p) => p.data.status === 'published')

const relatedPosts = specialty.relatedSlugs
  .map((slug) => allPosts.find((p) => p.id === slug))
  .filter(Boolean)

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: specialty.title,
  description: specialty.metaDescription,
  url: `https://www.zaydhealth.com/specialties/${specialty.slug}`,
  publisher: {
    '@type': 'Organization',
    name: 'Zayd Health',
    url: 'https://www.zaydhealth.com',
  },
}
---

<BaseLayout
  title={`${specialty.title} | Zayd Health`}
  description={specialty.metaDescription}
  canonical={`https://www.zaydhealth.com/specialties/${specialty.slug}`}
  jsonLd={jsonLd}
>
  <main id="main-content">
    <!-- Hero -->
    <section class="pt-32 sm:pt-44 pb-16 sm:pb-24 px-6 sm:px-8 bg-surface">
      <div class="max-w-4xl mx-auto">
        <nav class="flex items-center gap-2 text-sm text-on-surface-variant mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-tertiary transition-colors">Home</a>
          <span>›</span>
          <a href="/specialties" class="hover:text-tertiary transition-colors">Specialties</a>
          <span>›</span>
          <span>{specialty.name}</span>
        </nav>
        <h1 class="font-headline text-4xl sm:text-5xl md:text-6xl font-light leading-tight tracking-tight text-on-background mb-6">
          {specialty.hero}
        </h1>
        <p class="font-body text-lg sm:text-xl text-on-surface-variant leading-relaxed max-w-3xl mb-10">
          {specialty.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/#revenue-calculator"
            class="btn-primary px-8 py-4 text-on-primary font-medium rounded-sm shadow-ambient text-center"
          >
            Calculate Your Revenue
          </a>
          <a
            href="https://calendly.com/ali-zaydhealth/discovery"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 text-on-surface-variant font-medium rounded-sm ghost-border hover:bg-surface-container-low transition-colors text-center"
          >
            Schedule a Call
          </a>
        </div>
      </div>
    </section>

    <!-- Value Propositions -->
    <section class="py-24 sm:py-32 bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-6 sm:px-8">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-12 sm:mb-16 text-center">
          Why {specialty.name} practices choose Zayd
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {specialty.valueProps.map((prop) => (
            <div class="p-8 sm:p-10 bg-surface-container-lowest rounded-sm card-interactive">
              <div class="flex items-start gap-4 mb-4">
                <span class="material-symbols-outlined text-tertiary text-2xl flex-shrink-0 mt-0.5" aria-hidden="true">{prop.icon}</span>
                <h3 class="font-headline text-xl sm:text-2xl text-on-background">{prop.title}</h3>
              </div>
              <p class="text-on-surface-variant leading-relaxed">{prop.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <section class="py-24 sm:py-32 bg-surface">
        <div class="max-w-7xl mx-auto px-6 sm:px-8">
          <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-4">
            {specialty.name} RPM Resources
          </h2>
          <p class="text-on-surface-variant text-lg mb-12">
            Guides and best practices for {specialty.name.toLowerCase()} practices implementing RPM.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {relatedPosts.map((post) => {
              const cat = resolveCategory(post.data.tags)
              const url = getPostUrl(cat, post.id)
              return (
                <a href={url} class="group block bg-surface-container-lowest rounded-sm p-6 sm:p-8 card-interactive ghost-border">
                  <p class="text-xs tracking-widest uppercase font-semibold text-tertiary mb-3">{cat}</p>
                  <h3 class="font-headline text-lg sm:text-xl font-normal text-primary group-hover:text-tertiary transition-colors duration-300 mb-3 line-clamp-3">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-on-surface-variant line-clamp-3 mb-4">{post.data.description}</p>
                  <span class="text-xs font-semibold text-primary flex items-center gap-1 group-hover:text-tertiary transition-colors">
                    Read Guide
                    <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_forward</span>
                  </span>
                </a>
              )
            })}
          </div>
          <div class="mt-12 text-center">
            <a href="/resources" class="text-tertiary font-medium hover:underline underline-offset-4 transition-colors">
              Browse all resources →
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="py-24 sm:py-32 bg-surface-container-low px-6 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-12 sm:mb-16 text-center">
          {specialty.name} RPM Questions
        </h2>
        <div class="space-y-3">
          {specialty.faqs.map((faq, i) => (
            <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
              <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
                <span class="font-medium text-base sm:text-lg text-on-surface">{faq.question}</span>
                <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
              </summary>
              <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 sm:py-32 bg-secondary px-6 sm:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="max-w-3xl mx-auto bg-white/5 backdrop-blur-sm p-8 sm:p-14 rounded-sm ghost-border">
          <span class="material-symbols-outlined text-4xl text-on-secondary/40 mb-6 block" aria-hidden="true">analytics</span>
          <h2 class="font-headline text-3xl sm:text-4xl md:text-5xl font-light text-on-secondary leading-snug mb-6">
            Ready to add RPM to your {specialty.name.toLowerCase()} practice?
          </h2>
          <p class="text-on-secondary/60 text-lg mb-10 max-w-2xl mx-auto">
            See how much revenue your diabetic patient panel can generate and how Zayd handles the compliance documentation.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/#revenue-calculator"
              class="bg-tertiary text-on-tertiary px-8 py-4 font-medium rounded-sm shadow-ambient hover:brightness-110 transition-all"
            >
              Calculate Your Revenue
            </a>
            <a
              href="https://calendly.com/ali-zaydhealth/discovery"
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 text-on-secondary font-medium rounded-sm border border-on-secondary/20 hover:bg-white/10 transition-colors"
            >
              Schedule a Call
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="py-24 sm:py-32 bg-surface px-6 sm:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-headline text-4xl sm:text-5xl font-light text-on-background mb-6">
          The Monthly Synthesis
        </h2>
        <p class="font-body text-on-surface-variant text-lg mb-12">
          One email per month. RPM billing changes, compliance pitfalls, and the revenue strategies that actually work for your practice.
        </p>
        <div class="max-w-lg mx-auto">
          <EmailCapture client:visible minimal />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
