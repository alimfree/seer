---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { SPECIALTIES } from '../../lib/specialties'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'RPM by Medical Specialty',
  description: 'How different medical specialties use remote patient monitoring to improve diabetic patient outcomes and generate new revenue.',
  url: 'https://www.zaydhealth.com/specialties',
  publisher: {
    '@type': 'Organization',
    name: 'Zayd Health',
    url: 'https://www.zaydhealth.com',
  },
}
---

<BaseLayout
  title="RPM by Medical Specialty | Zayd Health"
  description="How different medical specialties use remote patient monitoring to improve diabetic patient outcomes and generate new revenue."
  canonical="https://www.zaydhealth.com/specialties"
  jsonLd={jsonLd}
>
  <main id="main-content">
    <section class="pt-32 sm:pt-44 pb-16 sm:pb-24 px-6 sm:px-8 bg-surface">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-headline text-4xl sm:text-5xl md:text-6xl font-light leading-tight tracking-tight text-on-background mb-6">
          RPM for Every Specialty
        </h1>
        <p class="font-body text-lg sm:text-xl text-on-surface-variant leading-relaxed max-w-3xl mx-auto">
          Diabetic patients exist across every specialty. Each has unique monitoring needs, medication interactions, and billing opportunities. Find yours.
        </p>
      </div>
    </section>

    <section class="py-24 sm:py-32 bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-6 sm:px-8">
        <div class="bg-primary rounded-sm p-6 sm:p-8 mb-12 sm:mb-16">
          <p class="text-on-primary/60 text-xs uppercase tracking-widest font-semibold mb-4 text-center">Jump to a specialty</p>
          <div class="flex flex-wrap gap-2 justify-center">
            {SPECIALTIES.slice(0, 7).map((s) => (
              <a
                href={`#${s.slug}`}
                class="px-4 py-2 text-sm font-medium bg-surface-container-lowest text-primary hover:bg-tertiary hover:text-on-tertiary transition-colors rounded-sm"
              >
                {s.name}
              </a>
            ))}
          </div>
          <div class="flex flex-wrap gap-2 justify-center mt-2">
            {SPECIALTIES.slice(7).map((s) => (
              <a
                href={`#${s.slug}`}
                class="px-4 py-2 text-sm font-medium bg-surface-container-lowest text-primary hover:bg-tertiary hover:text-on-tertiary transition-colors rounded-sm"
              >
                {s.name}
              </a>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10">
          {SPECIALTIES.map((s) => (
            <a id={s.slug} href={`/specialties/${s.slug}`} class="group block p-8 sm:p-10 bg-surface-container-lowest rounded-sm card-interactive ghost-border">
              <h2 class="font-headline text-xl sm:text-2xl text-on-background group-hover:text-tertiary transition-colors duration-300 mb-3">
                {s.name}
              </h2>
              <p class="text-sm text-on-surface-variant leading-relaxed mb-6 line-clamp-3">
                {s.description}
              </p>
              <span class="text-xs font-semibold text-primary flex items-center gap-1 group-hover:text-tertiary transition-colors">
                Learn more
                <span class="material-symbols-outlined text-sm group-hover:translate-x-1 transition-transform" aria-hidden="true">arrow_forward</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 sm:py-32 bg-surface px-6 sm:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-6">
          Not sure if RPM fits your practice?
        </h2>
        <p class="text-on-surface-variant text-lg mb-10 max-w-2xl mx-auto">
          If you have diabetic patients, you likely have untapped RPM revenue. Let's look at the numbers together.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#revenue-calculator" class="btn-primary px-8 py-4 text-on-primary font-medium rounded-sm shadow-ambient">
            Calculate Your Revenue
          </a>
          <a href="https://calendly.com/ali-zaydhealth/discovery" target="_blank" rel="noopener noreferrer" class="px-8 py-4 text-on-surface-variant font-medium rounded-sm ghost-border hover:bg-surface-container-low transition-colors">
            Schedule a Call
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
