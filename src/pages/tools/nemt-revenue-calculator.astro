---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Calculator from '../../components/react/Calculator'
import EmailCapture from '../../components/react/EmailCapture'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Free NEMT Missed-Call Revenue Calculator',
    description: 'Calculate how much revenue your NEMT operation is losing to missed after-hours calls and what an AI voice dispatcher could recover.',
    url: 'https://www.seermobility.com/tools/nemt-revenue-calculator',
    applicationCategory: 'BusinessApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    provider: { '@type': 'Organization', name: 'Seer Mobility', url: 'https://www.seermobility.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the missed-call revenue calculator work?',
        acceptedAnswer: { '@type': 'Answer', text: 'Enter your estimated after-hours missed calls per week and average private-pay trip value. We calculate what those calls are costing you and what an AI voice dispatcher could recover, then send a personalized analysis to your inbox.' },
      },
      {
        '@type': 'Question',
        name: "What if I don't know my exact missed-call volume?",
        acceptedAnswer: { '@type': 'Answer', text: "A rough estimate is fine. Most fleets underestimate this number since missed calls never show up on a report." },
      },
      {
        '@type': 'Question',
        name: 'Is this calculator free?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. Enter your numbers and email and we send a personalized revenue analysis to your inbox. Completely free, no credit card, no commitment.' },
      },
      {
        '@type': 'Question',
        name: 'What do I receive in my inbox?',
        acceptedAnswer: { '@type': 'Answer', text: 'A detailed breakdown of missed-call volume, recoverable rides, and what Seer Mobility handles for you.' },
      },
    ],
  },
]
---

<BaseLayout
  title="Free NEMT Missed-Call Revenue Calculator | Seer Mobility"
  description="Calculate how much revenue your NEMT operation is losing to missed after-hours calls. Free personalized recovery analysis sent to your inbox."
  canonical="https://www.seermobility.com/tools/nemt-revenue-calculator"
  jsonLd={jsonLd}
>
  <main id="main-content">
    <!-- Hero + Calculator -->
    <section class="pt-32 sm:pt-44 pb-24 sm:pb-32 px-6 sm:px-8 bg-surface">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <nav class="flex items-center gap-2 text-sm text-on-surface-variant mb-8" aria-label="Breadcrumb">
              <a href="/" class="hover:text-tertiary transition-colors">Home</a>
              <span>›</span>
              <span>NEMT Revenue Calculator</span>
            </nav>
            <h1 class="font-headline text-4xl sm:text-5xl font-light leading-tight tracking-tight text-on-background mb-6">
              How much revenue are missed calls costing your fleet?
            </h1>
            <p class="text-lg sm:text-xl text-on-surface-variant leading-relaxed mb-8">
              Most NEMT operators don't know how many after-hours calls go unanswered until it's already cost them tens of thousands of dollars. Enter your numbers and we'll show you exactly what's at stake.
            </p>
            <div class="space-y-4 mb-8">
              <div class="flex items-center gap-4 py-3 border-t border-outline-variant/30">
                <span class="material-symbols-outlined text-tertiary" aria-hidden="true">analytics</span>
                <span class="text-on-surface-variant">Revenue projection based on your missed-call volume and trip value</span>
              </div>
              <div class="flex items-center gap-4 py-3 border-t border-outline-variant/30">
                <span class="material-symbols-outlined text-tertiary" aria-hidden="true">trending_up</span>
                <span class="text-on-surface-variant">See what an AI voice dispatcher could recover annually</span>
              </div>
              <div class="flex items-center gap-4 py-3 border-t border-outline-variant/30">
                <span class="material-symbols-outlined text-tertiary" aria-hidden="true">check_circle</span>
                <span class="text-on-surface-variant">Free. No credit card. Takes 30 seconds.</span>
              </div>
            </div>
          </div>
          <Calculator client:visible />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-24 sm:py-32 bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-6 sm:px-8">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-12 sm:mb-16 text-center">
          How the calculator works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 sm:gap-12">
          <div class="text-center">
            <div class="w-16 h-16 btn-primary text-on-primary rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">local_shipping</span>
            </div>
            <h3 class="font-headline text-2xl mb-4">1. Enter your call volume</h3>
            <p class="text-on-surface-variant leading-relaxed">Tell us your estimated after-hours missed calls per week, average trip value, and fleet size.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 btn-primary text-on-primary rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">calculate</span>
            </div>
            <h3 class="font-headline text-2xl mb-4">2. We run the math</h3>
            <p class="text-on-surface-variant leading-relaxed">We model what those missed calls are costing you and what an AI voice dispatcher could recover.</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 btn-primary text-on-primary rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="material-symbols-outlined text-3xl" aria-hidden="true">mail</span>
            </div>
            <h3 class="font-headline text-2xl mb-4">3. Get your analysis</h3>
            <p class="text-on-surface-variant leading-relaxed">Receive a personalized revenue recovery breakdown, sent straight to your inbox.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Operators Miss NEMT Revenue -->
    <section class="py-24 sm:py-32 bg-surface">
      <div class="max-w-4xl mx-auto px-6 sm:px-8">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-12">
          Why most operators leave revenue uncaptured
        </h2>
        <div class="space-y-8">
          <div class="flex items-start gap-6">
            <span class="material-symbols-outlined text-tertiary text-2xl flex-shrink-0 mt-1" aria-hidden="true">close</span>
            <div>
              <h3 class="font-headline text-xl text-on-background mb-2">Calls come in around the clock, not just business hours</h3>
              <p class="text-on-surface-variant leading-relaxed">Discharge planners, nursing homes, and private-pay riders call after 5 PM and on weekends, when most fleets have no one answering the phone.</p>
            </div>
          </div>
          <div class="flex items-start gap-6">
            <span class="material-symbols-outlined text-tertiary text-2xl flex-shrink-0 mt-1" aria-hidden="true">close</span>
            <div>
              <h3 class="font-headline text-xl text-on-background mb-2">Callers rarely leave a voicemail</h3>
              <p class="text-on-surface-variant leading-relaxed">Most callers just hang up and book the next fleet on their list instead of waiting for a callback that may never come.</p>
            </div>
          </div>
          <div class="flex items-start gap-6">
            <span class="material-symbols-outlined text-tertiary text-2xl flex-shrink-0 mt-1" aria-hidden="true">close</span>
            <div>
              <h3 class="font-headline text-xl text-on-background mb-2">Missed calls never show up on a report</h3>
              <p class="text-on-surface-variant leading-relaxed">Unlike a denied claim, a missed call leaves no paper trail. The calculator shows you what's realistically recoverable for your fleet.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="py-24 sm:py-32 bg-secondary">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 text-center">
        <div class="max-w-4xl mx-auto bg-white/5 backdrop-blur-sm p-8 sm:p-14 rounded-sm ghost-border">
          <span class="material-symbols-outlined text-4xl text-on-secondary/40 mb-6 block" aria-hidden="true">verified</span>
          <p class="font-headline text-2xl sm:text-3xl md:text-4xl font-light text-on-secondary leading-snug mb-6">
            The typical NEMT fleet misses 20+ after-hours calls a week. Most of those callers never leave a voicemail.
          </p>
          <p class="text-on-secondary/60 text-lg mb-10">
            See what your fleet could recover with a 24/7 AI voice dispatcher.
          </p>
          <a
            href="#main-content"
            class="bg-tertiary text-on-tertiary px-8 py-4 font-medium rounded-sm shadow-ambient hover:brightness-110 transition-all inline-block"
          >
            Calculate Your Revenue
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 sm:py-32 bg-surface px-6 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-headline text-3xl sm:text-4xl font-light text-on-background mb-12 sm:mb-16 text-center">
          Questions
        </h2>
        <div class="space-y-3">
          <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
            <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-medium text-base sm:text-lg text-on-surface">How does the calculator work?</span>
              <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
            </summary>
            <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
              Enter your estimated after-hours missed calls per week, average private-pay trip value, and fleet size. We calculate what those calls are costing you and what an AI voice dispatcher could recover, then send a personalized analysis to your inbox.
            </div>
          </details>
          <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
            <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-medium text-base sm:text-lg text-on-surface">What if I don't know my exact missed-call volume?</span>
              <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
            </summary>
            <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
              A rough estimate is fine. Most fleets underestimate this number since missed calls never show up on a report the way a denied claim does.
            </div>
          </details>
          <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
            <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-medium text-base sm:text-lg text-on-surface">Is this really free?</span>
              <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
            </summary>
            <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
              Yes. No credit card, no commitment, no sales call required. We send the analysis to your email and that's it. If you want to talk through the numbers, you're welcome to get in touch. No obligation.
            </div>
          </details>
          <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
            <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-medium text-base sm:text-lg text-on-surface">What fleet types does this apply to?</span>
              <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
            </summary>
            <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
              The calculator works for any NEMT operator taking private-pay, discharge-planner, or facility bookings by phone. Call volume and trip value vary by service area and fleet size.
            </div>
          </details>
          <details class="bg-surface-container-lowest rounded-sm ghost-border shadow-sm group">
            <summary class="px-6 sm:px-8 py-5 sm:py-6 flex justify-between items-center cursor-pointer hover:bg-surface-bright transition-colors duration-200 list-none [&::-webkit-details-marker]:hidden">
              <span class="font-medium text-base sm:text-lg text-on-surface">How accurate is the projection?</span>
              <span class="material-symbols-outlined text-outline faq-icon group-open:open flex-shrink-0 ml-4" aria-hidden="true">expand_more</span>
            </summary>
            <div class="px-6 sm:px-8 pb-5 sm:pb-6 text-on-surface-variant">
              The calculator uses the missed-call volume and trip value you provide, benchmarked against a typical after-hours booking conversion rate. Your actual results depend on your service area and call mix.
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="py-24 sm:py-32 bg-surface-container-low px-6 sm:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-headline text-4xl sm:text-5xl font-light text-on-background mb-6">
          The Monthly Synthesis
        </h2>
        <p class="font-body text-on-surface-variant text-lg mb-12">
          One email per month. NEMT billing changes, broker portal updates, and the revenue strategies that actually work for your fleet.
        </p>
        <div class="max-w-lg mx-auto">
          <EmailCapture client:visible minimal />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
